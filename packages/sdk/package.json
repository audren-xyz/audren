{
  "name": "@audren/sdk",
  "version": "1.1.0",
  "type": "module",
  "description": "TypeScript SDK for Audren — zero-indexer BN254 Groth16 global MASP core (PDAs, Poseidon, layouts, CompactWalletStore, relayer, tx v1, IDLs) plus WASM Groth16 prover (@audren/sdk/prover)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./prover": {
      "types": "./dist/prover-entry.d.ts",
      "import": "./dist/prover-entry.js",
      "default": "./dist/prover-entry.js"
    },
    "./wasm/audren_circuits.wasm": "./wasm/audren_circuits.wasm",
    "./wasm/audren_joinsplit.pk": "./wasm/audren_joinsplit.pk",
    "./idl/codama.json": "./idl/audren.codama.json",
    "./idl/anchor.json": "./idl/audren.anchor.json"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "idl",
    "wasm",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
