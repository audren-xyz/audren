{
  "name": "audren-relay",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Standalone, protocol-agnostic Solana privacy relayer for Audren (relay.audren.xyz)",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "types": "wrangler types",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --config wrangler.prod.jsonc",
    "e2e": "tsx scripts/e2e-relay.ts"
  },
  "dependencies": {
    "@audren/sdk": "file:../../packages/sdk",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.166.0"
  }
}
