# Rust & Solana build artifacts
target/
**/target/
.scratch/
**/*.so
**/*.dylib
**/*.a
**/*.build.json
!**/tsconfig.build.json

# Swift & Kotlin/Gradle build artifacts
packages/swift/.build/
packages/swift/.swiftpm/
packages/swift/*.xcframework/
packages/kotlin/.gradle/
packages/kotlin/build/
packages/kotlin/src/main/jniLibs/

# Node / Next.js / Wrangler artifacts
node_modules/
**/node_modules/
dist/
**/dist/
.next/
**/.next/
out/
**/out/
.wrangler/
**/.wrangler/

# Local secrets, operator keypairs & production Wrangler overrides (NEVER commit!)
.credentials/
credentials/
*.keypair.json
*secret*.json
**/*.pem
**/*.key
.env
.env.*
!.env.example
.dev.vars
**/.dev.vars
!**/.dev.vars.example
**/wrangler.prod.jsonc
**/wrangler.local.jsonc

# OS / Python / TypeScript / Package tarball cache noise
.DS_Store
**/.DS_Store
*.log
*.tgz
**/__pycache__/
*.pyc
**/*.tsbuildinfo
